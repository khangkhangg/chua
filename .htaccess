# For shared hosting (Hostinger, cPanel): upload the whole repository into the site folder
# (for example public_html). Visitors only ever reach public/; settings and code stay private.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.git - [F,L]
  RewriteRule ^(src|sql|tests|realtime|docs|deploy|vendor)(/|$) - [F,L]
  RewriteRule ^(config(\.local)?(\.example)?\.php|.*\.md|\.gitignore)$ - [F,L]
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
